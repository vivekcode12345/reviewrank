{
  "manifest_version": 3,
  "name": "ReviewRank",
  "version": "2.0.0",
  "description": "Rank Amazon search results by customer review volume. See what people are choosing most.",
  "action": {
    "default_icon": "icons/icons.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.amazon.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*",
        "https://www.amazon.com/*"
      ],
      "js": ["lib/category-relevance.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icons.png",
    "48": "icons/icons.png",
    "128": "icons/icons.png"
  }
}
